# Copy to .env and edit:  cp .env.example .env

# Scope address (required). Find it on the scope: Utility > IO Setting > LAN Conf.
RIGOL_HOST=192.168.1.50
# RIGOL_PORT=5555

# Token clients must send as "Authorization: Bearer <token>". Generate one with:
#   openssl rand -hex 24
RIGOL_MCP_TOKEN=change-me

# Address clients use to reach this server. Used for links to screenshots and the gallery.
RIGOL_PUBLIC_URL=http://192.168.1.10:8790

# Port on the Docker host (default 8790).
# RIGOL_HOST_PORT=8790

# How many screenshots / waveform CSVs to keep (oldest are deleted). 0 = keep all.
# RIGOL_KEEP_SCREENSHOTS=100
# RIGOL_KEEP_WAVEFORMS=100
# RIGOL_KEEP_LOGS=50
# RIGOL_KEEP_EXPORTS=10       # full-memory dumps can be up to ~600 MB each as CSV

# Set to 1 to block every tool that changes the scope.
# RIGOL_READ_ONLY=0

# Owner of the files in ./data (run `id -u` and `id -g`).
# UID=1000
# GID=1000
